[Desktop Entry]
Categories=GNOME;GTK;System;TerminalEmulator;
Comment=Configure the command line
DBusActivatable=false
Exec=my-gnome-terminal --preferences
Icon=my.GnomeTerminal.Preferences
Keywords=shell;prompt;command;commandline;cmd;
Name=My Terminal Preferences
NoDisplay=true
SingleMainWindow=true
StartupNotify=true
StartupWMClass=My-gnome-terminal-preferences
TryExec=my-gnome-terminal
Type=Application
